# Copy to .env and fill in (never commit .env)
OPENROUTER_API_KEY=

# Optional — shown on openrouter.ai rankings
OPENROUTER_SITE_URL=http://localhost
OPENROUTER_APP_NAME=Ghost Users

# Ghost Users binds loopback only. Leave DATA_DIR empty to use <repo>/.data
GHOST_HOST=127.0.0.1
GHOST_PORT=8787
ORBIT_HOST=127.0.0.1
ORBIT_PORT=8788
GHOST_DATA_DIR=
GHOST_MODEL=anthropic/claude-sonnet-4.6
# scripts/manage.py writes a local control token under the data dir.
# Set ORBIT_CONTROL_TOKEN only when you start the processes yourself.
